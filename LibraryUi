function Section:_nextLayout()
    self._nextOrder = self._nextOrder + 1
    return self._nextOrder
end

function Section:_removeElement(element)
    for index, item in ipairs(self.Elements) do
        if item == element then
            table.remove(self.Elements, index)
            break
        end
    end
    self:Refresh()
end

function Section:Refresh()
    if self._destroyed then
        return
    end
    if self._open then
        self.Body.Visible = true
        self.Card.AutomaticSize = Enum.AutomaticSize.Y
        self.Card.Size = UDim2.new(1, 0, 0, 0)
    end
end

function Section:SetOpen(open, instant)
    open = not not open
    if self._destroyed or self._open == open then
        return self
    end
    self._open = open
    self._animToken = self._animToken + 1
    local token = self._animToken

    local card = self.Card
    local body = self.Body

    if open then
        body.Visible = true
    end

    card.AutomaticSize = Enum.AutomaticSize.None
    card.ClipsDescendants = true
    local startHeight = card.AbsoluteSize.Y
    card.Size = UDim2.new(1, 0, 0, startHeight)

    local targetHeight = 60
    if open then
        targetHeight = 60 + body.AbsoluteSize.Y
    end

    local rotateTarget = open and 0 or -90
    tw(self._chevron, instant and 0.01 or 0.25, {Rotation = rotateTarget}, QUINT, EASE_OUT)

    if instant then
        card.Size = UDim2.new(1, 0, 0, targetHeight)
        card.AutomaticSize = open and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
        body.Visible = open
        return self
    end

    local animation = tw(card, 0.28, {
        Size = UDim2.new(1, 0, 0, targetHeight),
    }, QUINT, EASE_OUT)

    animation.Completed:Connect(function()
        if self._destroyed or self._animToken ~= token then
            return
        end
        if self._open then
            card.AutomaticSize = Enum.AutomaticSize.Y
            card.Size = UDim2.new(1, 0, 0, 0)
        else
            body.Visible = false
        end
    end)

    return self
end

function Section:Toggle()
    return self:SetOpen(not self._open)
end

function Section:SetTitle(title)
    self.Title = tostring(title or "")
    self._titleLabel.Text = string.upper(self.Title)
    return self
end

function Section:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    local elements = {}
    for index, element in ipairs(self.Elements) do
        elements[index] = element
    end
    for _, element in ipairs(elements) do
        element:Destroy()
    end
    for index, item in ipairs(self.Tab.Sections) do
        if item == self then
            table.remove(self.Tab.Sections, index)
            break
        end
    end
    if self.Tab.LastSection == self then
        self.Tab.LastSection = self.Tab.Sections[#self.Tab.Sections]
    end
    self.Card:Destroy()
end

function Window:_buildElement(tab, section, kind, config)
    if type(config) == "string" then
        config = {Name = config}
    elseif type(config) ~= "table" then
        config = {}
    end
    local builder = Builders[kind]
    if not builder then
        error("[SnowyCode UI] Unknown element type: " .. tostring(kind))
    end
    local element = builder(self, tab, section, config)
    if not element then
        return nil
    end
    if element.Instance then
        element.Instance.LayoutOrder = section:_nextLayout()
        element.Instance.Name = tostring(config.Name or kind)
    end
    self:_registerElement(element, config)
    section:Refresh()
    if element._applyTheme then
        element._applyTheme()
    end
    return element
end

local tabFactories = {
    Button = "Button",
    Toggle = "Toggle",
    Slider = "Slider",
    Dropdown = "Dropdown",
    Input = "Input",
    Keybind = "Keybind",
    ColorPicker = "ColorPicker",
    Label = "Label",
    Paragraph = "Paragraph",
    Divider = "Divider",
}

for factoryName, kind in pairs(tabFactories) do
    local methodName = "Create" .. factoryName
    local elementKind = kind
    Tab[methodName] = function(tab, config)
        return tab.Window:_buildElement(tab, tab:_ensureSection(), elementKind, config)
    end
    Section[methodName] = function(section, config)
        return section.Window:_buildElement(section.Tab, section, elementKind, config)
    end
end

function Tab:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    self.Window:_closePopups()

    for _, section in ipairs(self.Sections) do
        section._destroyed = true
        local elements = {}
        for index, element in ipairs(section.Elements) do
            elements[index] = element
        end
        for _, element in ipairs(elements) do
            element:Destroy()
        end
    end

    self.Group:Destroy()
    self.Button:Destroy()

    local window = self.Window
    for index, tab in ipairs(window._tabs) do
        if tab == self then
            table.remove(window._tabs, index)
            break
        end
    end
    for index, tab in ipairs(window._tabs) do
        tab.Index = index
        tab.Button.LayoutOrder = index
    end

    if window._selected == self then
        window._selected = nil
        local nextTab = window._tabs[1]
        if nextTab then
            window:SelectTab(nextTab, true)
        end
    end
end

