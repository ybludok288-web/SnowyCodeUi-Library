function Window:_alpha(base)
    return math.clamp((base or 0) + self._transparency, 0, 0.97)
end

function Window:_hook(callback)
    table.insert(self._themeHooks, callback)
    local ok, err = pcall(callback, self._theme)
    if not ok and not Snowy.Silent then
        warn("[SnowyCode UI] Theme hook error: " .. tostring(err))
    end
end

function Window:_refreshTheme()
    for _, callback in ipairs(self._themeHooks) do
        local ok, err = pcall(callback, self._theme)
        if not ok and not Snowy.Silent then
            warn("[SnowyCode UI] Theme hook error: " .. tostring(err))
        end
    end
end

function Window:_syncShadow()
    local window = self._window
    local position = window.Position
    local size = window.Size
    if self._shadow then
        self._shadow.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + 8)
        self._shadow.Size = UDim2.new(size.X.Scale, size.X.Offset, size.Y.Scale, size.Y.Offset)
        self._shadow.Visible = self._config.Shadow and self._open
    end
    if self._glow then
        self._glow.Position = UDim2.new(position.X.Scale, position.X.Offset - 7, position.Y.Scale, position.Y.Offset - 7)
        self._glow.Size = UDim2.new(size.X.Scale, size.X.Offset + 14, size.Y.Scale, size.Y.Offset + 14)
        self._glow.Visible = self._config.Shadow and self._open
    end
end

function Window:_fadeShadow(show)
    if not self._config.Shadow then
        return
    end
    if show then
        if self._shadow then
            self._shadow.Visible = true
            self._shadow.BackgroundTransparency = 1
            tw(self._shadow, 0.3, {BackgroundTransparency = 0.55}, QUINT, EASE_OUT)
        end
        if self._glow then
            self._glow.Visible = true
            self._glow.BackgroundTransparency = 1
            tw(self._glow, 0.32, {BackgroundTransparency = 0.94}, QUINT, EASE_OUT)
        end
    else
        if self._shadow then
            tw(self._shadow, 0.18, {BackgroundTransparency = 1}, QUAD, EASE_IN)
        end
        if self._glow then
            tw(self._glow, 0.18, {BackgroundTransparency = 1}, QUAD, EASE_IN)
        end
    end
end

function Window:_applyResponsive()
    if self._destroyed then
        return
    end
    local viewport = getViewport()
    local compact = viewport.X < 640
    self._compact = compact

    local configSize = self._config.Size
    local width = configSize.X.Scale * viewport.X + configSize.X.Offset
    local height = configSize.Y.Scale * viewport.Y + configSize.Y.Offset
    width = math.clamp(width, 300, math.max(300, viewport.X - 20))
    height = math.clamp(height, 260, math.max(260, viewport.Y - 20))
    if compact then
        width = math.min(width, math.max(280, viewport.X - 20))
        height = math.min(height, math.max(240, viewport.Y - 20))
    end
    self._size = Vector2.new(roundNumber(width), roundNumber(height))

    if not self._dragged then
        if self._config.Position then
            local position = self._config.Position
            self._position = Vector2.new(
                position.X.Scale * viewport.X + position.X.Offset,
                position.Y.Scale * viewport.Y + position.Y.Offset
            )
        else
            self._position = Vector2.new(
                roundNumber((viewport.X - self._size.X) / 2),
                roundNumber((viewport.Y - self._size.Y) / 2)
            )
        end
    end
    self._position = clampWindowPosition(self._position, self._size, viewport)

    local currentSize = self._minimized
        and Vector2.new(self._size.X, TOPBAR_H)
        or self._size

    self._window.Size = UDim2.new(0, currentSize.X, 0, currentSize.Y)
    self._window.Position = UDim2.new(0, self._position.X, 0, self._position.Y)

    local sidebarX = compact and 10 or 14
    local sidebarWidth = compact and 58 or 186
    local contentX = sidebarX + sidebarWidth + (compact and 8 or 10)
    local contentRight = compact and 10 or 14

    self._sidebar.Position = UDim2.new(0, sidebarX, 0, TOPBAR_H + 8)
    self._sidebar.Size = UDim2.new(0, sidebarWidth, 1, -(TOPBAR_H + 22))
    self._sidebarStroke.Transparency = 0.94

    self._footer.Visible = self._config.Footer and not compact
    self._tabHolder.Position = UDim2.new(0, compact and 6 or 8, 0, compact and 6 or 8)
    self._tabHolder.Size = UDim2.new(
        1,
        compact and -12 or -16,
        1,
        compact and -12 or -34
    )

    self._content.Position = UDim2.new(0, contentX, 0, TOPBAR_H + 8)
    self._content.Size = UDim2.new(1, -(contentX + contentRight), 1, -(TOPBAR_H + 22))

    self._titleLabel.Size = UDim2.new(
        1,
        compact and -100 or (self._config.ShowUser and -320 or -130),
        0,
        18
    )
    self._subtitleLabel.Visible = not compact
    self._subtitleLabel.Size = self._titleLabel.Size
    self._userPill.Visible = self._config.ShowUser and not compact

    self._notifHolder.Size = UDim2.new(0, math.min(320, viewport.X - 20), 1, -20)
    self._notifHolder.Position = UDim2.new(1, -10, 0, 10)

    for _, tab in ipairs(self._tabs) do
        tab:_layout(compact)
    end

    self:_syncShadow()
end

function Window:_setupDrag()
    local selfWindow = self

    self._dragArea.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if selfWindow._destroyed then
            return
        end

        local startPointer = pointerPosition(input)
        local startPosition = Vector2.new(
            selfWindow._window.AbsolutePosition.X,
            selfWindow._window.AbsolutePosition.Y
        )
        selfWindow._dragging = true
        selfWindow._dragged = true
        selfWindow:_closePopups()

        local moveConnection
        local endConnection

        local function stopDragging()
            selfWindow._dragging = false
            if moveConnection then
                moveConnection:Disconnect()
            end
            if endConnection then
                endConnection:Disconnect()
            end
        end

        moveConnection = UserInputService.InputChanged:Connect(function(changed)
            if not selfWindow._dragging then
                return
            end
            if changed.UserInputType ~= Enum.UserInputType.MouseMovement
                and changed.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local pointer = pointerPosition(changed)
            local newPosition = startPosition + (pointer - startPointer)
            newPosition = clampWindowPosition(newPosition, selfWindow._window.AbsoluteSize, getViewport())
            selfWindow._position = newPosition
            selfWindow._window.Position = UDim2.new(0, newPosition.X, 0, newPosition.Y)
            selfWindow:_syncShadow()
        end)

        endConnection = UserInputService.InputEnded:Connect(function(ended)
            if ended.UserInputType == input.UserInputType then
                stopDragging()
            end
        end)

        table.insert(selfWindow._connections, moveConnection)
        table.insert(selfWindow._connections, endConnection)
    end)
end

function Window:Open()
    if self._destroyed or self._open then
        return self
    end
    self._open = true
    self._gui.Enabled = true
    self._window.Visible = true
    self:_applyResponsive()

    local targetPosition = self._position
    self._window.Position = UDim2.new(0, targetPosition.X, 0, targetPosition.Y)
    self:_syncShadow()
    self:_fadeShadow(true)
    self._window.Position = UDim2.new(0, targetPosition.X, 0, targetPosition.Y + 14)
    if HAS_CANVAS then
        self._window.GroupTransparency = 1
    end

    local properties = {
        Position = UDim2.new(0, targetPosition.X, 0, targetPosition.Y),
    }
    if HAS_CANVAS then
        properties.GroupTransparency = 0
    end
    tw(self._window, 0.3, properties, QUINT, EASE_OUT)

    if self._blurSize > 0 and not self._minimized then
        BlurManager:set(self._id, self._blurSize)
    end
    return self
end

function Window:Close()
    if self._destroyed or not self._open then
        return self
    end
    self._open = false
    self:_closePopups()
    BlurManager:set(self._id, nil)

    local properties = {
        Position = UDim2.new(0, self._position.X, 0, self._position.Y + 12),
    }
    if HAS_CANVAS then
        properties.GroupTransparency = 1
    else
        properties.BackgroundTransparency = 1
    end
    local animation = tw(self._window, 0.18, properties, QUAD, EASE_IN)
    self:_fadeShadow(false)
    animation.Completed:Connect(function()
        if not self._open and not self._destroyed then
            self._window.Visible = false
            if self._shadow then
                self._shadow.Visible = false
            end
            if self._glow then
                self._glow.Visible = false
            end
        end
    end)
    return self
end

function Window:Toggle()
    if self._open then
        return self:Close()
    end
    return self:Open()
end

function Window:IsOpen()
    return self._open
end

function Window:SetMinimized(state)
    state = not not state
    if self._destroyed or self._minimized == state then
        return self
    end
    self._minimized = state
    self:_closePopups()

    if self._open and self._blurSize > 0 then
        if state then
            BlurManager:set(self._id, nil)
        else
            BlurManager:set(self._id, self._blurSize)
        end
    end

    local target = state
        and Vector2.new(self._size.X, TOPBAR_H)
        or self._size

    if not state then
        self._sidebar.Visible = true
        self._content.Visible = true
    end

    local animation = tw(self._window, 0.28, {
        Size = UDim2.new(0, target.X, 0, target.Y),
    }, QUINT, EASE_OUT)

    if self._shadow then
        tw(self._shadow, 0.28, {
            Size = UDim2.new(0, target.X, 0, target.Y),
        }, QUINT, EASE_OUT)
    end
    if self._glow then
        tw(self._glow, 0.28, {
            Size = UDim2.new(0, target.X + 14, 0, target.Y + 14),
        }, QUINT, EASE_OUT)
    end

    animation.Completed:Connect(function()
        if self._minimized and not self._destroyed then
            self._sidebar.Visible = false
            self._content.Visible = false
        end
    end)
    return self
end

function Window:Minimize()
    return self:SetMinimized(true)
end

function Window:Restore()
    return self:SetMinimized(false)
end

function Window:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    self._open = false
    self:_closePopups()
    BlurManager:set(self._id, nil)

    for _, connection in ipairs(self._connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    for _, element in ipairs(self._elements) do
        element._destroyed = true
        if element._closePopup then
            pcall(element._closePopup)
        end
        for _, connection in ipairs(element._connections or {}) do
            pcall(function()
                connection:Disconnect()
            end)
        end
        if element._flag and Snowy.Flags[element._flag] == element then
            Snowy.Flags[element._flag] = nil
        end
    end
    self._elements = {}

    for index, window in ipairs(Snowy._windows) do
        if window == self then
            table.remove(Snowy._windows, index)
            break
        end
    end

    if self._gui then
        self._gui:Destroy()
    end
end

function Window:SetTheme(theme)
    self._theme = resolveTheme(theme)
    self._config.Theme = theme
    self:_closePopups()
    self:_refreshTheme()
    return self
end

function Window:SetTransparency(value)
    self._transparency = math.clamp(tonumber(value) or 0, 0, 0.6)
    self._config.Transparency = self._transparency
    self:_refreshTheme()
    return self
end

function Window:SetAccent(color, secondColor)
    if typeof(color) == "Color3" then
        self._theme.Accent = color
    end
    if typeof(secondColor) == "Color3" then
        self._theme.Accent2 = secondColor
    end
    self._config.Accent = self._theme.Accent
    self._config.Accent2 = self._theme.Accent2
    self:_refreshTheme()
    return self
end

function Window:SetBlur(size)
    size = math.max(0, tonumber(size) or 0)
    self._blurSize = size
    self._config.Blur = size
    if self._open and not self._minimized then
        if size > 0 then
            BlurManager:set(self._id, size)
        else
            BlurManager:set(self._id, nil)
        end
    end
    return self
end

function Window:SetToggleKey(key)
    if key == false then
        self._toggleKey = nil
    else
        self._toggleKey = key
    end
    return self
end

function Window:SetTitle(title)
    self._config.Title = tostring(title or "")
    self._titleLabel.Text = self._config.Title
    return self
end

function Window:SetSubtitle(subtitle)
    self._config.Subtitle = tostring(subtitle or "")
    self._subtitleLabel.Text = self._config.Subtitle
    return self
end

function Window:_registerElement(element, config)
    table.insert(self._elements, element)
    if config and config.Flag ~= nil then
        local flag = tostring(config.Flag)
        element._flag = flag
        Snowy.Flags[flag] = element
    end
end

function Window:_unregisterElement(element)
    for index, item in ipairs(self._elements) do
        if item == element then
            table.remove(self._elements, index)
            break
        end
    end
    if element._flag and Snowy.Flags[element._flag] == element then
        Snowy.Flags[element._flag] = nil
    end
end

function Window:_setPopup(closeFunction)
    if self._popupClose and self._popupClose ~= closeFunction then
        local previous = self._popupClose
        self._popupClose = nil
        pcall(previous)
    end
    self._popupClose = closeFunction
end

function Window:_clearPopup(closeFunction)
    if self._popupClose == closeFunction then
        self._popupClose = nil
    end
end

function Window:_closePopups()
    local closeFunction = self._popupClose
    self._popupClose = nil
    if closeFunction then
        pcall(closeFunction)
    end
end

