local function popupPosition(anchor, width, height, align)
    local viewport = getViewport()
    local absolute = anchor.AbsolutePosition
    local size = anchor.AbsoluteSize
    local x
    if align == "right" then
        x = absolute.X + size.X - width
    else
        x = absolute.X
    end
    x = math.clamp(x, 8, math.max(8, viewport.X - width - 8))
    local y = absolute.Y + size.Y + 6
    if y + height > viewport.Y - 8 then
        y = absolute.Y - height - 6
    end
    y = math.clamp(y, 8, math.max(8, viewport.Y - height - 8))
    return Vector2.new(roundNumber(x), roundNumber(y))
end

local function createPopupShell(window, anchor, width, height, align, name)
    local theme = window._theme
