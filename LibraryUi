function Window:SelectTab(tab, instant)
    if self._destroyed or not tab or tab._destroyed then
        return self
    end
    if self._selected == tab then
        return self
    end
    self:_closePopups()

    local previous = self._selected
    local direction = 14
    if previous and previous.Index and tab.Index and previous.Index > tab.Index then
        direction = -14
    end

    if previous then
        previous._active = false
        previous:_applyState(true)
        previous.Scroll.Visible = false
        previous.Group.Visible = false
    end

    self._selected = tab
    tab._active = true
    tab:_applyState(true)
    tab.Group.Visible = true
    tab.Scroll.Visible = true

    if HAS_CANVAS then
        if instant then
            tab.Group.GroupTransparency = 0
        else
            tab.Group.GroupTransparency = 1
            tw(tab.Group, 0.24, {GroupTransparency = 0}, QUAD, EASE_OUT)
        end
    end

    if instant then
        tab.Scroll.Position = UDim2.new(0, 0, 0, 0)
    else
        tab.Scroll.Position = UDim2.new(0, direction, 0, 0)
        tw(tab.Scroll, 0.3, {Position = UDim2.new(0, 0, 0, 0)}, QUINT, EASE_OUT)
    end

    return self
end

function Window:GetTabs()
    local result = {}
    for index, tab in ipairs(self._tabs) do
        result[index] = tab
    end
    return result
end

function Tab:_applyState(animate)
    local theme = self.Window._theme
    local active = self._active
    local hover = self._hover

    local transparency = 1
    if active then
        transparency = 0.8
    elseif hover then
        transparency = 0.94
    end

    local textColor = active and theme.Text or (hover and theme.Text or theme.SubText)
    local iconColor = active and theme.OnAccent or theme.SubText

    if animate then
        tw(self.Button, 0.16, {BackgroundTransparency = transparency})
        tw(self._label, 0.16, {TextColor3 = textColor})
        if self._iconImage then
            tw(self._iconImage, 0.16, {ImageColor3 = iconColor})
        end
        if self._iconLetter then
            tw(self._iconLetter, 0.16, {TextColor3 = iconColor})
        end
    else
        self.Button.BackgroundTransparency = transparency
        self._label.TextColor3 = textColor
        if self._iconImage then
            self._iconImage.ImageColor3 = iconColor
        end
        if self._iconLetter then
            self._iconLetter.TextColor3 = iconColor
        end
    end

    if self._gradient then
        if active then
            self._gradient.Color = ColorSequence.new(theme.Accent, theme.Accent2)
        else
            self._gradient.Color = ColorSequence.new(theme.Surface, theme.Surface)
        end
    end
    if self._iconTileGradient then
        if active then
            self._iconTileGradient.Color = ColorSequence.new(theme.Accent, theme.Accent2)
        else
            self._iconTileGradient.Color = ColorSequence.new(theme.ToggleOff, theme.Surface)
        end
    end
end

function Tab:_layout(compact)
    if self._destroyed then
        return
    end
    self.Button.Size = UDim2.new(1, 0, 0, 38)
    if compact then
        self._iconHolder.AnchorPoint = Vector2.new(0.5, 0.5)
        self._iconHolder.Position = UDim2.new(0.5, 0, 0.5, 0)
        self._label.Visible = false
    else
        self._iconHolder.AnchorPoint = Vector2.new(0, 0.5)
        self._iconHolder.Position = UDim2.new(0, 9, 0.5, 0)
        self._label.Visible = true
    end
end

