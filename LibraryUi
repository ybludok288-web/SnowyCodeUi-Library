    addPadding(menu, 8, 8, 8, 8)
    local menuGradient = addGradient(menu, theme.Panel, theme.Background2, 100)
    local menuStroke = addStroke(menu, theme.Stroke, 0.82, 1)

    local escapeConnection
    local closed = false
    local close

    local function fadeOut()
        if closed then
            return
        end
        closed = true
        window:_clearPopup(close)
        if HAS_CANVAS then
            tw(menu, 0.16, {GroupTransparency = 1}, QUAD, EASE_IN)
        else
            tw(menu, 0.16, {BackgroundTransparency = 1}, QUAD, EASE_IN)
        end
        tw(menu, 0.16, {
            Position = UDim2.new(0, position.X, 0, position.Y + 4),
        }, QUAD, EASE_IN)
        if escapeConnection then
            escapeConnection:Disconnect()
            escapeConnection = nil
        end
        if closer then
            closer:Destroy()
            closer = nil
        end
        task.delay(0.2, function()
            if menu and menu.Parent then
                menu:Destroy()
            end
        end)
    end
    close = fadeOut

    if closer then
        closer.MouseButton1Click:Connect(function()
            close()
        end)
    end

    escapeConnection = UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Escape then
            close()
        end
    end)

    if HAS_CANVAS then
        tw(menu, 0.22, {
            GroupTransparency = 0,
            Position = UDim2.new(0, position.X, 0, position.Y),
        }, QUINT, EASE_OUT)
    else
        tw(menu, 0.22, {
            Position = UDim2.new(0, position.X, 0, position.Y),
        }, QUINT, EASE_OUT)
    end

    menu.BackgroundColor3 = theme.Panel
    menuGradient.Color = ColorSequence.new(theme.Panel, theme.Background2)
    menuStroke.Color = theme.Stroke
    window:_setPopup(close)

    return menu, close, position
end

local function normalizeOptions(options)
    local result = {}
    if type(options) ~= "table" then
        return result
    end
    for _, option in ipairs(options) do
        table.insert(result, tostring(option))
    end
    return result
end

local function listContains(list, value)
    for _, item in ipairs(list) do
        if item == value then
            return true
        end
    end
    return false
end

function Builders.Dropdown(window, tab, section, config)
    local theme = window._theme
    local description = rowDescription(config)
    local rowHeight = description and 58 or 48
    local multi = config.Multi == true
    local options = normalizeOptions(config.Options)
    local placeholder = tostring(config.Placeholder or "Select...")

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, rowHeight),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = section.Body,
    })
    addCorner(row, 9)

    local title, desc = rowLabels(window, row, config, theme, 0.52)
    local control = rowControl(row, 0.46, 30)

    local trigger = new("TextButton", {
        Name = "DropdownButton",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.Input,
        BackgroundTransparency = window:_alpha(0.18),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = control,
    })
    addCorner(trigger, 8)
    local triggerStroke = addStroke(trigger, theme.Stroke, 0.86, 1)

    local triggerLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -34, 1, 0),
        Text = placeholder,
        TextColor3 = theme.Muted,
        TextSize = 11,
        Font = FONT_MED,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = trigger,
    })

    local chevron, chevronBars = makeChevron(10, theme.SubText)
    chevron.AnchorPoint = Vector2.new(0.5, 0.5)
    chevron.Position = UDim2.new(1, -13, 0.5, 0)
    chevron.Parent = trigger

    local initialValue
    if multi then
        initialValue = {}
        if type(config.Value) == "table" then
            for _, value in ipairs(config.Value) do
                local text = tostring(value)
                if listContains(options, text) and not listContains(initialValue, text) then
                    table.insert(initialValue, text)
                end
            end
        end
    else
        if config.Value ~= nil then
            initialValue = tostring(config.Value)
        end
    end

    local element = createElement(window, tab, section, row, {
        _value = initialValue,
        _nameLabel = title,
        _hover = false,
        _multi = multi,
        _options = options,
        _popupOpen = false,
        _refreshOpen = nil,
    })

    local function selected(option)
        if multi then
            return listContains(element._value, option)
        end
        return element._value == option
    end

    local function updateTrigger()
        local labelText = placeholder
        local hasValue = false
        if multi then
            local count = #element._value
            if count == 1 then
                labelText = element._value[1]
                hasValue = true
            elseif count > 1 then
                labelText = tostring(count) .. " selected"
                hasValue = true
            end
        elseif element._value then
            labelText = element._value
            hasValue = true
        end
        triggerLabel.Text = labelText
        triggerLabel.TextColor3 = hasValue and window._theme.Text or window._theme.Muted
    end

    local openMenu

    local function resetMenuState()
        element._popupOpen = false
        element._refreshOpen = nil
        element._closePopup = nil
        element._popupMenu = nil
        openMenu = nil
        if not element._destroyed then
            tw(chevron, 0.2, {Rotation = 0}, QUAD, EASE_OUT)
            tw(triggerStroke, 0.2, {Color = window._theme.Stroke, Transparency = 0.86})
        end
    end

    local function closeMenu()
        if not element._popupOpen then
            return
        end
        local closeShell = openMenu
        resetMenuState()
        if closeShell then
            closeShell()
        end
    end

    local function buildMenu()

        local theme = window._theme
        local searchEnabled = config.Search == true or #element._options > 6
        local viewport = getViewport()
        local menuWidth = math.min(
            math.max(190, math.floor(trigger.AbsoluteSize.X)),
            math.max(160, viewport.X - 16)
        )
        local optionHeight = 30
        local contentHeight = #element._options * optionHeight
            + math.max(0, #element._options - 1) * 3
        local listHeight = math.clamp(contentHeight, 36, 232)
        local searchHeight = searchEnabled and 35 or 0
        local menuHeight = 16 + searchHeight + listHeight
        menuHeight = math.min(menuHeight, math.max(60, viewport.Y - 16))

        local menu, closeShell = createPopupShell(
            window,
            trigger,
            menuWidth,
            menuHeight,
            "left",
            "SnowyDropdown"
        )

        local searchBox
        if searchEnabled then
            searchBox = new("Frame", {
                Name = "SearchBox",
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundColor3 = theme.Input,
                BackgroundTransparency = window:_alpha(0.12),
                BorderSizePixel = 0,
                Parent = menu,
            })
            addCorner(searchBox, 7)
            local searchStroke = addStroke(searchBox, theme.Stroke, 0.88, 1)
            local searchInput = new("TextBox", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Text = "",
                PlaceholderText = "Search...",
                PlaceholderColor3 = theme.Muted,
                TextColor3 = theme.Text,
                TextSize = 11,
                Font = FONT,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Parent = searchBox,
            })
            addPadding(searchInput, 0, 0, 8, 8)
            searchInput.Focused:Connect(function()
                searchStroke.Color = theme.Accent
                searchStroke.Transparency = 0.4
            end)
            searchInput.FocusLost:Connect(function()
                searchStroke.Color = theme.Stroke
                searchStroke.Transparency = 0.88
            end)
            searchBox._input = searchInput
        end

        local list = new("ScrollingFrame", {
            Name = "Options",
            Position = UDim2.new(0, 0, 0, searchHeight),
            Size = UDim2.new(1, 0, 1, -searchHeight),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = theme.Accent,
            ScrollBarImageTransparency = 0.5,
            Parent = menu,
        })
        addList(list, 3)

        local noResults = new("TextLabel", {
            Name = "NoResults",
            Position = UDim2.new(0, 0, 0, searchHeight),
            Size = UDim2.new(1, 0, 1, -searchHeight),
            BackgroundTransparency = 1,
            Text = "No results",
            TextColor3 = theme.Muted,
            TextSize = 11,
            Font = FONT,
            Visible = false,
            ZIndex = 2,
            Parent = menu,
        })

        local rows = {}

        local function refreshRows()
            for _, optionRow in ipairs(rows) do
                local isSelected = selected(optionRow.Option)
                optionRow.Check.BackgroundColor3 = isSelected and theme.Accent or theme.ToggleOff
                optionRow.Check.BackgroundTransparency = isSelected and 0 or 0.25
                optionRow.CheckIcon.Visible = isSelected
                optionRow.Label.TextColor3 = isSelected and theme.Text or theme.SubText
            end
        end

        local function filterRows()
            if not searchBox then
                return
            end
            local query = string.lower(searchBox._input.Text)
            local visibleCount = 0
            for _, optionRow in ipairs(rows) do
                local matches = query == ""
                    or string.find(string.lower(optionRow.Option), query, 1, true) ~= nil
                optionRow.Instance.Visible = matches
                if matches then
                    visibleCount = visibleCount + 1
                end
            end
            noResults.Visible = visibleCount == 0
        end

        for _, option in ipairs(element._options) do
            local optionButton = new("TextButton", {
                Size = UDim2.new(1, 0, 0, optionHeight),
                BackgroundColor3 = theme.Surface,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Parent = list,
            })
            addCorner(optionButton, 7)

            local check = new("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(0, 7, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = theme.ToggleOff,
                BackgroundTransparency = 0.25,
                BorderSizePixel = 0,
                Parent = optionButton,
            })
            addCorner(check, 4)

            local checkIcon, checkBars = makeCheckIcon(8, theme.OnAccent)
            checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
            checkIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
            checkIcon.Parent = check
            checkIcon.Visible = false

            local optionLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 29, 0, 0),
                Size = UDim2.new(1, -36, 1, 0),
                Text = option,
                TextColor3 = theme.SubText,
                TextSize = 11,
                Font = FONT_MED,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = optionButton,
            })

            local optionRow = {
                Instance = optionButton,
                Option = option,
                Check = check,
                CheckIcon = checkIcon,
                Label = optionLabel,
            }
            table.insert(rows, optionRow)

            optionButton.MouseEnter:Connect(function()
                tw(optionButton, 0.12, {BackgroundTransparency = 0.85})
            end)
            optionButton.MouseLeave:Connect(function()
                tw(optionButton, 0.12, {BackgroundTransparency = 1})
            end)
            optionButton.MouseButton1Click:Connect(function()
                if multi then
                    local index
                    for itemIndex, item in ipairs(element._value) do
                        if item == option then
                            index = itemIndex
                            break
                        end
                    end
                    if index then
                        table.remove(element._value, index)
                    else
                        table.insert(element._value, option)
                    end
                    updateTrigger()
                    refreshRows()
                    safeCall(config.Callback, element._value, element)
                else
                    element._value = option
                    updateTrigger()
                    refreshRows()
                    safeCall(config.Callback, option, element)
                    closeMenu()
                end
            end)
        end

        if searchBox then
            searchBox._input:GetPropertyChangedSignal("Text"):Connect(filterRows)
        end

        element._refreshOpen = function()
            updateTrigger()
            refreshRows()
            filterRows()
        end
        element._closePopup = closeMenu
        element._popupMenu = menu
        menu.Destroying:Connect(function()
            if element._popupMenu == menu then
                resetMenuState()
            end
        end)
        refreshRows()
        openMenu = closeShell
        element._popupOpen = true
    end

    local function open()
        if element._popupOpen then
            closeMenu()
            return
        end
        buildMenu()
        tw(chevron, 0.2, {Rotation = 180}, QUAD, EASE_OUT)
        tw(triggerStroke, 0.2, {Color = window._theme.Accent, Transparency = 0.42})
    end

    bind(element, trigger.MouseButton1Click, open)
    element.Get = function()
        if multi then
            local copy = {}
            for index, value in ipairs(element._value) do
                copy[index] = value
            end
            return copy
        end
        return element._value
    end

    element._set = function(value, silent)
        if multi then
            local newValue = {}
            if type(value) == "table" then
                for _, item in ipairs(value) do
                    local text = tostring(item)
                    if listContains(element._options, text) and not listContains(newValue, text) then
                        table.insert(newValue, text)
                    end
                end
            end
            element._value = newValue
        else
            if value == nil then
                element._value = nil
            else
                element._value = tostring(value)
            end
        end
        updateTrigger()
        if element._refreshOpen then
            element._refreshOpen()
        end
        if not silent then
            if multi then
                safeCall(config.Callback, element._value, element)
            else
                safeCall(config.Callback, element._value, element)
            end
        end
    end

    function element.SetOptions(self, newOptions)
        self._options = normalizeOptions(newOptions)
        if self._multi then
            local filtered = {}
            for _, value in ipairs(self._value) do
                if listContains(self._options, value) then
                    table.insert(filtered, value)
                end
            end
            self._value = filtered
        elseif self._value and not listContains(self._options, self._value) then
            self._value = nil
        end
        updateTrigger()
        if self._popupOpen then
            closeMenu()
        end
    end

    bind(element, trigger.MouseEnter, function()
        tw(triggerStroke, 0.15, {Transparency = 0.65})
    end)
    bind(element, trigger.MouseLeave, function()
        if not element._popupOpen then
            tw(triggerStroke, 0.15, {Transparency = 0.86})
        end
    end)

    window:_hook(function(currentTheme)
        row.BackgroundColor3 = currentTheme.Surface
        title.TextColor3 = currentTheme.Text
        if desc then
            desc.TextColor3 = currentTheme.Muted
        end
        trigger.BackgroundColor3 = currentTheme.Input
        trigger.BackgroundTransparency = window:_alpha(0.18)
        triggerStroke.Color = currentTheme.Stroke
        for _, bar in ipairs(chevronBars) do
            bar.BackgroundColor3 = currentTheme.SubText
        end
        updateTrigger()
    end)

    updateTrigger()
    return element
end

