function Builders.Slider(window, tab, section, config)
    local theme = window._theme
    local description = rowDescription(config)
    local rowHeight = description and 66 or 56
    local minimum = tonumber(config.Min) or 0
    local maximum = tonumber(config.Max) or 100
    if maximum <= minimum then
        maximum = minimum + 100
    end
    local step = tonumber(config.Step) or (maximum - minimum <= 1 and 0.01 or 1)
    if step <= 0 then
        step = 1
    end
    local initial = tonumber(config.Value) or minimum
    initial = math.clamp(initial, minimum, maximum)
    local suffix = tostring(config.Suffix or "")
    local prefix = tostring(config.Prefix or "")

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, rowHeight),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = section.Body,
    })
    addCorner(row, 9)

    local title, desc = rowLabels(window, row, config, theme, 0.6)
    local valueLabel = new("TextLabel", {
        Name = "Value",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 7),
        Size = UDim2.new(0, 90, 0, 16),
        Text = prefix .. formatValue(initial, step, config.Format) .. suffix,
        TextColor3 = theme.Accent,
        TextSize = 12,
        Font = FONT_MED,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })

    local trackY = description and 44 or 34
    local trackButton = new("TextButton", {
        Name = "TrackButton",
        Size = UDim2.new(1, -16, 0, 20),
        Position = UDim2.new(0, 8, 0, trackY),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })

    local line = new("Frame", {
        Name = "Line",
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0.5, -2),
        BackgroundColor3 = theme.ToggleOff,
        BorderSizePixel = 0,
        Parent = trackButton,
    })
    addCorner(line, 2)

    local fill = new("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Parent = line,
    })
    addCorner(fill, 2)
    local fillGradient = addGradient(fill, theme.Accent, theme.Accent2, 0)

    local knob = new("Frame", {
        Name = "Knob",
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.OnAccent,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = trackButton,
    })
    addCorner(knob, 8)
    local knobStroke = addStroke(knob, theme.Accent, 0.35, 2)

    local element = createElement(window, tab, section, row, {
        _value = initial,
        _nameLabel = title,
        _hover = false,
        _min = minimum,
        _max = maximum,
        _step = step,
    })

    local function fraction()
        if maximum == minimum then
            return 0
        end
        return (element._value - minimum) / (maximum - minimum)
    end

    local function updateVisual(instant)
        local alpha = math.clamp(fraction(), 0, 1)
        if instant then
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        else
            tw(fill, 0.12, {Size = UDim2.new(alpha, 0, 1, 0)})
            tw(knob, 0.12, {Position = UDim2.new(alpha, 0, 0.5, 0)})
        end
        valueLabel.Text = prefix
            .. formatValue(element._value, element._step, config.Format)
            .. suffix
    end

    local function setValue(value, silent, instant)
        if element._destroyed then
            return
        end
        value = tonumber(value)
        if not value then
            return
        end
        value = math.clamp(value, minimum, maximum)
        value = minimum + math.floor((value - minimum) / step + 0.5) * step
        value = math.clamp(value, minimum, maximum)
        if math.abs(value - element._value) < 0.000001 then
            return
        end
        element._value = value
        updateVisual(instant)
        if not silent then
            safeCall(config.Callback, value, element)
        end
    end
    element._set = function(value, silent)
        setValue(value, silent, false)
    end
    element.SetRange = function(self, newMin, newMax, newStep)
        minimum = tonumber(newMin) or minimum
        maximum = tonumber(newMax) or maximum
        if maximum <= minimum then
            maximum = minimum + 1
        end
        element._min = minimum
        element._max = maximum
        if newStep then
            step = math.max(0.000001, tonumber(newStep) or step)
            element._step = step
        end
        element._value = math.clamp(element._value, minimum, maximum)
        updateVisual(true)
    end

    local dragging = false
    local function setFromPointer(input)
        local pointer = pointerPosition(input)
        local width = math.max(trackButton.AbsoluteSize.X, 1)
        local alpha = (pointer.X - trackButton.AbsolutePosition.X) / width
        alpha = math.clamp(alpha, 0, 1)
        local value = minimum + (maximum - minimum) * alpha
        setValue(value, false, true)
    end

    bind(element, trackButton.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        setFromPointer(input)
    end)
    bind(element, UserInputService.InputChanged, function(input)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        setFromPointer(input)
    end)
    bind(element, UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    bind(element, trackButton.MouseEnter, function()
        tw(knob, 0.16, {Size = UDim2.new(0, 18, 0, 18)}, BACK, EASE_OUT)
    end)
    bind(element, trackButton.MouseLeave, function()
        if not dragging then
            tw(knob, 0.16, {Size = UDim2.new(0, 16, 0, 16)}, QUAD, EASE_OUT)
        end
    end)

    window:_hook(function(currentTheme)
        row.BackgroundColor3 = currentTheme.Surface
        title.TextColor3 = currentTheme.Text
        if desc then
            desc.TextColor3 = currentTheme.Muted
        end
        valueLabel.TextColor3 = currentTheme.Accent
        line.BackgroundColor3 = currentTheme.ToggleOff
        fillGradient.Color = ColorSequence.new(currentTheme.Accent, currentTheme.Accent2)
        knob.BackgroundColor3 = currentTheme.OnAccent
        knobStroke.Color = currentTheme.Accent
    end)

    updateVisual(true)
    return element
end

