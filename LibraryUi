                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Parent = presets,
            })
            addCorner(preset, 4)
            addStroke(preset, theme.Stroke, 0.72, 1)
            local presetScale = new("UIScale", {Scale = 1, Parent = preset})
            preset.MouseEnter:Connect(function()
                tw(presetScale, 0.14, {Scale = 1.18}, BACK, EASE_OUT)
            end)
            preset.MouseLeave:Connect(function()
                tw(presetScale, 0.14, {Scale = 1}, QUAD, EASE_OUT)
            end)
            preset.MouseButton1Click:Connect(function()
                setFromColor(presetColor, true)
            end)
        end

        local function applyPopupColor(color)
            local currentHue = select(1, Color3.toHSV(color))
            hueLayer.BackgroundColor3 = color
            hueGradient.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromHSV(currentHue, 1, 1))
            svCursor.Position = UDim2.new(saturation, 0, 1 - value, 0)
            hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
            if not hexInput:IsFocused() then
                hexInput.Text = toHex(color)
            end
        end
        element._applyPopupColor = applyPopupColor
        applyPopupColor(element._value)

        local svDragging = false
        local hueDragging = false

        local function setSaturationValue(input)
            local pointer = pointerPosition(input)
            local alphaX = (pointer.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1)
            local alphaY = (pointer.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1)
            saturation = math.clamp(alphaX, 0, 1)
            value = 1 - math.clamp(alphaY, 0, 1)
            applyColor(true)
        end

        local function setHue(input)
            local pointer = pointerPosition(input)
            local alpha = (pointer.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1)
            hue = math.clamp(alpha, 0, 1)
            applyColor(true)
        end

        svButton.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            svDragging = true
            setSaturationValue(input)
        end)
        hueButton.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            hueDragging = true
            setHue(input)
        end)
        table.insert(pickerConnections, UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            if svDragging then
                setSaturationValue(input)
            elseif hueDragging then
                setHue(input)
            end
        end))
        table.insert(pickerConnections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                svDragging = false
                hueDragging = false
            end
        end))

        hexInput.Focused:Connect(function()
            tw(hexStroke, 0.15, {Color = theme.Accent})
        end)
        hexInput.FocusLost:Connect(function()
            tw(hexStroke, 0.15, {Color = theme.Stroke})
            local parsed = fromHex(hexInput.Text)
            if parsed then
                setFromColor(parsed, true)
            else
                hexInput.Text = toHex(element._value)
            end
        end)

        element._closePopup = closePicker
        element._popupMenu = menu
        menu.Destroying:Connect(function()
            if element._popupMenu == menu then
                resetPickerState()
            end
        end)
        openPicker = closeShell
        element._popupOpen = true
    end

    local function open()
        if element._popupOpen then
            closePicker()
            return
        end
        buildPicker()
        tw(triggerStroke, 0.18, {Color = window._theme.Accent, Transparency = 0.42})
    end

    bind(element, trigger.MouseButton1Click, open)
    bind(element, trigger.MouseEnter, function()
        tw(triggerStroke, 0.15, {Transparency = 0.65})
    end)
    bind(element, trigger.MouseLeave, function()
        if not element._popupOpen then
            tw(triggerStroke, 0.15, {Transparency = 0.86})
        end
    end)

    window:_hook(function(currentTheme)
        row.BackgroundColor3 = currentTheme.Surface
        title.TextColor3 = currentTheme.Text
        if desc then
            desc.TextColor3 = currentTheme.Muted
        end
        trigger.BackgroundColor3 = currentTheme.Input
        trigger.BackgroundTransparency = window:_alpha(0.18)
        triggerStroke.Color = currentTheme.Stroke
        triggerText.TextColor3 = currentTheme.Text
    end)

    return element
end

function Window:Notify(config)
    if self._destroyed then
        return nil
    end
    if type(config) == "string" then
        config = {Title = config}
    elseif type(config) ~= "table" then
        config = {}
    end

    local theme = self._theme
    local kind = string.lower(tostring(config.Type or "info"))
    local accent = theme.Accent
    local heading = tostring(config.Title or "Notification")
    if kind == "success" then
        accent = theme.Success
        heading = config.Title and tostring(config.Title) or "Success"
    elseif kind == "warning" then
        accent = theme.Warning
        heading = config.Title and tostring(config.Title) or "Warning"
    elseif kind == "error" then
        accent = theme.Error
        heading = config.Title and tostring(config.Title) or "Error"
    end

    local duration = tonumber(config.Duration) or 5
    local persistent = config.Persistent == true or duration <= 0
    if duration <= 0 then
        duration = 5
    end

    local cardClass = HAS_CANVAS and "CanvasGroup" or "Frame"
    local card = new(cardClass, {
        Name = "Notification",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.Panel,
        BackgroundTransparency = 0.03,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = self._notifHolder,
    })
    if HAS_CANVAS then
        card.GroupTransparency = 1
    end
    addCorner(card, 12)
    addPadding(card, 11, 11, 12, 10)
    addList(card, 6)
    local cardGradient = addGradient(card, theme.Panel, theme.Background2, 90)
    local cardStroke = addStroke(card, accent, 0.76, 1)
    local scale = new("UIScale", {Scale = 0.96, Parent = card})

    local header = new("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = 1,
        Parent = card,
    })

    local icon = new("Frame", {
        Name = "Icon",
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.78,
        BorderSizePixel = 0,
        Parent = header,
    })
    addCorner(icon, 9)
    addStroke(icon, accent, 0.55, 1)

    if kind == "success" then
        local check, checkBars = makeCheckIcon(9, theme.OnAccent)
        check.AnchorPoint = Vector2.new(0.5, 0.5)
        check.Position = UDim2.new(0.5, 0, 0.5, 0)
        check.Parent = icon
        for _, bar in ipairs(checkBars) do
            bar.BackgroundColor3 = accent
        end
    else
        local symbol = (kind == "warning" or kind == "error") and "!" or "i"
        new("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = symbol,
            TextColor3 = accent,
            TextSize = 11,
            Font = FONT_BOLD,
            Parent = icon,
        })
    end

    local titleLabel = new("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 26, 0, 0),
        Size = UDim2.new(1, -48, 1, 0),
        Text = heading,
        TextColor3 = theme.Text,
        TextSize = 12,
        Font = FONT_BOLD,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = header,
    })

    local closeButton = new("TextButton", {
        Name = "Close",
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = header,
    })
    addCorner(closeButton, 6)
    local closeIcon, closeBars = makeCloseIcon(7, theme.SubText)
    closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
    closeIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
    closeIcon.Parent = closeButton

    local contentLabel
    if config.Content and tostring(config.Content) ~= "" then
        contentLabel = new("TextLabel", {
            Name = "Content",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = tostring(config.Content),
            TextColor3 = theme.SubText,
            TextSize = 11,
            Font = FONT,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            Parent = card,
        })
    end

    local progress
    local progressFill
    if not persistent then
        progress = new("Frame", {
            Name = "Progress",
            Size = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = theme.ToggleOff,
            BackgroundTransparency = 0.55,
            BorderSizePixel = 0,
            LayoutOrder = 3,
            Parent = card,
        })
        addCorner(progress, 1)
        progressFill = new("Frame", {
            Name = "Fill",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = accent,
            BorderSizePixel = 0,
            Parent = progress,
        })
        addCorner(progressFill, 1)
        addGradient(progressFill, accent, theme.Accent2, 0)
    end

    local closed = false
    local progressTween
    local entry = {Card = card}

    local function dismiss()
        if closed then
            return
        end
        closed = true
        if self._destroyed then
            return
        end
        if progressTween then
            pcall(function()
                progressTween:Cancel()
            end)
        end
        if HAS_CANVAS then
            tw(card, 0.18, {GroupTransparency = 1}, QUAD, EASE_IN)
        else
            tw(card, 0.18, {BackgroundTransparency = 1}, QUAD, EASE_IN)
        end
        tw(scale, 0.18, {Scale = 0.95}, QUAD, EASE_IN)
        task.delay(0.2, function()
            if card and card.Parent then
                card:Destroy()
            end
        end)
        for index, item in ipairs(self._notifications) do
            if item == entry then
                table.remove(self._notifications, index)
                break
            end
        end
    end
    entry.Dismiss = dismiss

    closeButton.MouseEnter:Connect(function()
        tw(closeButton, 0.12, {BackgroundTransparency = 0.85})
        for _, bar in ipairs(closeBars) do
            tw(bar, 0.12, {BackgroundColor3 = self._theme.Text})
        end
    end)
    closeButton.MouseLeave:Connect(function()
        tw(closeButton, 0.12, {BackgroundTransparency = 1})
        for _, bar in ipairs(closeBars) do
            tw(bar, 0.12, {BackgroundColor3 = self._theme.SubText})
        end
    end)
    closeButton.MouseButton1Click:Connect(dismiss)

    if HAS_CANVAS then
        tw(card, 0.24, {GroupTransparency = 0}, QUINT, EASE_OUT)
    else
        tw(card, 0.24, {BackgroundTransparency = 0.03}, QUINT, EASE_OUT)
    end
    tw(scale, 0.28, {Scale = 1}, BACK, EASE_OUT)

    table.insert(self._notifications, entry)
    if #self._notifications > 5 then
        local oldest = self._notifications[1]
        if oldest and oldest ~= entry then
            oldest.Dismiss()
        end
    end

    if not persistent then
        task.delay(0.12, function()
            if closed or not progressFill or not progressFill.Parent then
                return
            end
            progressTween = TweenService:Create(
                progressFill,
                TweenInfo.new(duration, Enum.EasingStyle.Linear),
                {Size = UDim2.new(0, 0, 1, 0)}
            )
            progressTween:Play()
        end)
        task.delay(duration + 0.25, dismiss)
    end

    return entry
end

function Window:Dialog(config)
    if self._destroyed then
        return nil
    end
    if type(config) ~= "table" then
        config = {}
    end

    local theme = self._theme
    local viewport = getViewport()
    local width = math.min(360, viewport.X - 32)
    local dismissable = config.Dismissable ~= false
    self:_closePopups()

    local backdrop = new("TextButton", {
        Name = "DialogBackdrop",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.Shadow,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        TextTransparency = 1,
        AutoButtonColor = false,
        ZIndex = DIALOG_Z,
        Parent = self._gui,
    })

    local cardClass = HAS_CANVAS and "CanvasGroup" or "Frame"
    local card = new(cardClass, {
        Name = "SnowyDialog",
        Size = UDim2.new(0, width, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0.5, 0, 0.5, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Panel,
        BackgroundTransparency = 0.02,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = DIALOG_Z + 1,
        Parent = self._gui,
    })
    if HAS_CANVAS then
        card.GroupTransparency = 1
    end
    addCorner(card, 16)
    addPadding(card, 18, 18, 18, 18)
    addList(card, 10)
    addGradient(card, theme.Panel, theme.Background2, 100)
    addStroke(card, theme.Stroke, 0.84, 1)

    local titleLabel = new("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = tostring(config.Title or "SnowyCode UI"),
        TextColor3 = theme.Text,
        TextSize = 15,
        Font = FONT_BOLD,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        LayoutOrder = 1,
        Parent = card,
    })

    local contentLabel
    if config.Content and tostring(config.Content) ~= "" then
        contentLabel = new("TextLabel", {
            Name = "Content",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = tostring(config.Content),
            TextColor3 = theme.SubText,
            TextSize = 12,
            Font = FONT,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            Parent = card,
        })
    end

    local buttonHolder = new("Frame", {
        Name = "Buttons",
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = 3,
        Parent = card,
    })

    local closed = false
    local escapeConnection
    local handle = {Instance = card}

    local function close()
        if closed then
            return
        end
        closed = true
        if escapeConnection then
            escapeConnection:Disconnect()
            escapeConnection = nil
        end
        if HAS_CANVAS then
            tw(card, 0.18, {GroupTransparency = 1}, QUAD, EASE_IN)
        else
            tw(card, 0.18, {BackgroundTransparency = 1}, QUAD, EASE_IN)
        end
        tw(card, 0.18, {Position = UDim2.new(0.5, 0, 0.5, 10)}, QUAD, EASE_IN)
        tw(backdrop, 0.18, {BackgroundTransparency = 1}, QUAD, EASE_IN)
        task.delay(0.2, function()
            if backdrop and backdrop.Parent then
                backdrop:Destroy()
            end
            if card and card.Parent then
                card:Destroy()
            end
        end)
    end

    handle.Close = close
    handle.SetTitle = function(_, text)
        titleLabel.Text = tostring(text or "")
    end
    handle.SetContent = function(_, text)
        if contentLabel then
            contentLabel.Text = tostring(text or "")
        end
    end

    local buttons = config.Buttons
    if type(buttons) ~= "table" or #buttons == 0 then
        buttons = {{Name = "OK", Primary = true}}
    end

    local buttonGap = 8
    local buttonWidth = math.min(
        104,
        math.max(72, math.floor((width - 36 - (#buttons - 1) * buttonGap) / #buttons))
    )
    local offset = 0
    for index = #buttons, 1, -1 do
        local buttonConfig = buttons[index]
        if type(buttonConfig) == "string" then
            buttonConfig = {Name = buttonConfig}
        end
        local isPrimary = buttonConfig.Primary == true or #buttons == 1
        local button = new("TextButton", {
            Name = "DialogButton_" .. tostring(index),
            Size = UDim2.new(0, buttonWidth, 1, 0),
            Position = UDim2.new(1, -offset, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = isPrimary and theme.Accent or theme.Element,
            BackgroundTransparency = isPrimary and 0.04 or window:_alpha(0.35),
            BorderSizePixel = 0,
            Text = tostring(buttonConfig.Name or "OK"),
            TextColor3 = isPrimary and theme.OnAccent or theme.Text,
            TextSize = 12,
            Font = FONT_MED,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            Parent = buttonHolder,
        })
        addCorner(button, 8)
        if isPrimary then
            addGradient(button, theme.Accent, theme.Accent2, 25)
            addStroke(button, theme.Accent, 0.5, 1)
        else
            addStroke(button, theme.Stroke, 0.9, 1)
        end
        local buttonScale = new("UIScale", {Scale = 1, Parent = button})
        button.MouseEnter:Connect(function()
            tw(button, 0.14, {
                BackgroundTransparency = isPrimary and 0 or window:_alpha(0.2),
            })
        end)
        button.MouseLeave:Connect(function()
            tw(button, 0.14, {
                BackgroundTransparency = isPrimary and 0.04 or window:_alpha(0.35),
            })
        end)
        button.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                tw(buttonScale, 0.08, {Scale = 0.97})
            end
        end)
        button.InputEnded:Connect(function()
            tw(buttonScale, 0.16, {Scale = 1}, BACK, EASE_OUT)
        end)
        button.MouseButton1Click:Connect(function()
            safeCall(buttonConfig.Callback, handle)
            if buttonConfig.Close ~= false then
                close()
            end
        end)
        offset = offset + buttonWidth + buttonGap
    end

    backdrop.MouseButton1Click:Connect(function()
        if dismissable then
            close()
        end
    end)
    if dismissable then
        escapeConnection = UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Escape then
                close()
            end
        end)
    end

    tw(backdrop, 0.24, {BackgroundTransparency = 0.55}, QUAD, EASE_OUT)
    if HAS_CANVAS then
        tw(card, 0.26, {GroupTransparency = 0}, QUINT, EASE_OUT)
    else
        tw(card, 0.26, {BackgroundTransparency = 0.02}, QUINT, EASE_OUT)
    end
    tw(card, 0.3, {Position = UDim2.new(0.5, 0, 0.5, 0)}, QUINT, EASE_OUT)

    return handle
end

function Snowy:GetFlag(flag)
    local element = self.Flags[tostring(flag)]
    if element and not element._destroyed then
        return element:Get()
    end
    return nil
end

function Snowy:SetFlag(flag, value)
    local element = self.Flags[tostring(flag)]
    if element and not element._destroyed then
        element:Set(value)
        return true
    end
    return false
end

function Snowy:GetFlags()
    local result = {}
    for flag, element in pairs(self.Flags) do
        if element and not element._destroyed then
            result[flag] = element:Get()
        end
    end
    return result
end

function Snowy:SetFlags(values)
    if type(values) ~= "table" then
        return self
    end
    for flag, value in pairs(values) do
        self:SetFlag(flag, value)
    end
    return self
end

function Snowy:GetWindows()
    local result = {}
    for index, window in ipairs(self._windows) do
        result[index] = window
    end
    return result
end

function Snowy:Notify(config)
    local window = self._windows[1]
    if window then
        return window:Notify(config)
    end
    return nil
end

function Snowy:Dialog(config)
    local window = self._windows[1]
    if window then
        return window:Dialog(config)
    end
    return nil
end

function Snowy:DestroyAll()
    local windows = {}
    for index, window in ipairs(self._windows) do
        windows[index] = window
    end
    for _, window in ipairs(windows) do
        window:Destroy()
    end
    self._windows = {}
end

return Snowy
