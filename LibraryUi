local BlurManager = {
    users = {},
    effect = nil,
}

function BlurManager:refresh()
    local largest = 0
    for _, size in pairs(self.users) do
        if size > largest then
            largest = size
        end
    end

    if largest > 0 and (not self.effect or not self.effect.Parent) then
        local existing = Lighting:FindFirstChild("SnowyCodeUI_Blur")
        if existing and existing:IsA("BlurEffect") then
            self.effect = existing
        else
            self.effect = new("BlurEffect", {
                Name = "SnowyCodeUI_Blur",
                Size = 0,
                Parent = Lighting,
            })
        end
    end

    if self.effect then
        tw(self.effect, 0.28, {Size = largest})
        if largest == 0 then
            local effect = self.effect
            self.effect = nil
            task.delay(0.35, function()
                if effect and effect.Parent and not self.effect then
                    effect:Destroy()
                end
            end)
        end
    end
end

function BlurManager:set(owner, size)
    if size and size > 0 then
        self.users[owner] = size
    else
        self.users[owner] = nil
    end
    self:refresh()
end

