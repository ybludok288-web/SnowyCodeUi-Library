function Builders.Button(window, tab, section, config)
    local theme = window._theme
    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = theme.Element,
        BackgroundTransparency = window:_alpha(0.42),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = true,
        Parent = section.Body,
    })
    addCorner(row, 10)
    local gradient = addGradient(row, theme.Element, theme.Panel, 25)
    local stroke = addStroke(row, theme.Stroke, 0.9, 1)
    local scale = new("UIScale", {Scale = 1, Parent = row})

    local content = new("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        ZIndex = 2,
        Parent = row,
    })
    addList(content, 7, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

    local iconImage
    local iconAsset = imageAsset(config.Icon)
    if iconAsset then
        iconImage = new("ImageLabel", {
            Size = UDim2.new(0, 15, 0, 15),
            BackgroundTransparency = 1,
            Image = iconAsset,
            ImageColor3 = theme.SubText,
            ZIndex = 3,
            Parent = content,
        })
    end

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Text = tostring(config.Name or "Button"),
        TextColor3 = theme.Text,
        TextSize = 13,
        Font = FONT_MED,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
        Parent = content,
    })

    local element = createElement(window, tab, section, row, {
        _value = true,
        _nameLabel = label,
        _hover = false,
    })
    element._set = function(value)
        if type(value) == "function" then
            return
        end
    end

    local function ripple(input)
        if row:FindFirstChild("Ripple") then
            row.Ripple:Destroy()
        end
        local pointer = pointerPosition(input)
        local point = pointer - row.AbsolutePosition
        local radius = math.max(row.AbsoluteSize.X, row.AbsoluteSize.Y) * 0.9
        local wave = new("Frame", {
            Name = "Ripple",
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0, point.X, 0, point.Y),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = theme.OnAccent,
            BackgroundTransparency = 0.72,
            BorderSizePixel = 0,
            ZIndex = 1,
            Parent = row,
        })
        addCorner(wave, 999)
        tw(wave, 0.55, {
            Size = UDim2.new(0, radius * 2.2, 0, radius * 2.2),
            BackgroundTransparency = 1,
        }, QUAD, EASE_OUT)
        task.delay(0.6, function()
            if wave and wave.Parent then
                wave:Destroy()
            end
        end)
    end

    bind(element, row.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            ripple(input)
            tw(scale, 0.08, {Scale = 0.985})
        end
    end)
    bind(element, row.InputEnded, function()
        tw(scale, 0.16, {Scale = 1}, BACK, EASE_OUT)
    end)
    bind(element, row.MouseEnter, function()
        tw(row, 0.16, {BackgroundTransparency = window:_alpha(0.25)})
        tw(stroke, 0.16, {Color = window._theme.Accent, Transparency = 0.6})
        tw(scale, 0.16, {Scale = 1.006})
    end)
    bind(element, row.MouseLeave, function()
        tw(row, 0.16, {BackgroundTransparency = window:_alpha(0.42)})
        tw(stroke, 0.16, {Color = window._theme.Stroke, Transparency = 0.9})
        tw(scale, 0.16, {Scale = 1})
    end)
    bind(element, row.MouseButton1Click, function()
        safeCall(config.Callback, element)
    end)

    window:_hook(function(currentTheme)
        row.BackgroundColor3 = currentTheme.Element
        row.BackgroundTransparency = window:_alpha(0.42)
        gradient.Color = ColorSequence.new(currentTheme.Element, currentTheme.Panel)
        stroke.Color = currentTheme.Stroke
        stroke.Transparency = 0.9
        label.TextColor3 = currentTheme.Text
        if iconImage then
            iconImage.ImageColor3 = currentTheme.SubText
        end
    end)

    return element
end

