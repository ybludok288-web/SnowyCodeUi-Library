end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local ok, err = pcall(callback, ...)
    if not ok and not Snowy.Silent then
        warn("[SnowyCode UI] Callback error: " .. tostring(err))
    end
end

local function roundNumber(number)
    return math.floor(number + 0.5)
end

local function formatValue(value, step, format)
    if type(format) == "function" then
        local ok, result = pcall(format, value)
        if ok and result ~= nil then
            return tostring(result)
        end
    end
    step = tonumber(step) or 1
    if step >= 1 then
        return tostring(roundNumber(value))
    end
    local decimals = 0
    local probe = step
    while probe < 1 and decimals < 5 do
        probe = probe * 10
        decimals = decimals + 1
    end
    return string.format("%." .. tostring(decimals) .. "f", value)
end

local function toHex(color)
    return string.format(
        "#%02X%02X%02X",
        roundNumber(color.R * 255),
        roundNumber(color.G * 255),
        roundNumber(color.B * 255)
    )
end

local function fromHex(value)
    local text = tostring(value or ""):gsub("#", ""):gsub("%s", "")
    if #text == 3 then
        text = text:sub(1, 1) .. text:sub(1, 1)
            .. text:sub(2, 2) .. text:sub(2, 2)
            .. text:sub(3, 3) .. text:sub(3, 3)
    end
    if #text ~= 6 then
        return nil
    end
    local number = tonumber(text, 16)
    if not number then
        return nil
    end
    local r = math.floor(number / 65536) % 256
    local g = math.floor(number / 256) % 256
    local b = number % 256
    return Color3.fromRGB(r, g, b)
end

local function imageAsset(value)
    if type(value) == "number" then
        return "rbxassetid://" .. tostring(value)
    end
    if type(value) == "string" and value ~= "" then
        if value:match("^%d+$") then
            return "rbxassetid://" .. value
        end
        return value
    end
    return nil
end

local function keyName(value)
    if typeof(value) == "EnumItem" then
        return value.Name
    end
    if type(value) == "string" and value ~= "" then
        return value
    end
    return nil
end

local function nameFromInput(input)
    if not input then
        return nil
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        return "MouseButton1"
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        return "MouseButton2"
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        return "MouseButton3"
    end
    if input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
        return input.KeyCode.Name
    end
    return nil
end

local function pointerPosition(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        return Vector2.new(input.Position.X, input.Position.Y)
    end
    return UserInputService:GetMouseLocation()
end

local function getViewport()
    local camera = Workspace.CurrentCamera
    if camera then
        return camera.ViewportSize
    end
    return Vector2.new(1280, 720)
end

local function copyTable(source)
    local result = {}
    for key, value in pairs(source) do
        result[key] = value
    end
    return result
end

