function Element:Get()
    return self._value
end

function Element:Set(value, silent)
    if self._destroyed or not self._set then
        return
    end

    self._set(value, silent == true)
end

function Element:SetVisible(visible)
    if self.Instance then
        self.Instance.Visible = not not visible
    end
end

function Element:SetName(name)
    self._name = tostring(name or "")
    if self.Instance then
        self.Instance.Name = self._name
    end
    if self._nameLabel then
        self._nameLabel.Text = self._name
    end
end

function Element:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true

    if self._closePopup then
        local ok = pcall(self._closePopup)
        if not ok then
            self._closePopup = nil
        end
    end

    for _, connection in ipairs(self._connections or {}) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    if self.Instance then
        self.Instance:Destroy()
    end

    if self.Window then
        self.Window:_unregisterElement(self)
    end
    if self.Section then
        self.Section:_removeElement(self)
    end
end

local function bind(element, signal, callback)
    local connection = signal:Connect(callback)
    table.insert(element._connections, connection)
    return connection
end

local function createElement(window, tab, section, instance, data)
    local element = {
        Window = window,
        Tab = tab,
        Section = section,
        Instance = instance,
        _connections = {},
        _value = nil,
        _destroyed = false,
    }
    if data then
        for key, value in pairs(data) do
            element[key] = value
        end
    end
    return setmetatable(element, Element)
end

local function resolveTheme(value)
    if type(value) == "table" then
        return copyTable(value)
    end
    if type(value) == "string" and Themes[value] then
        return copyTable(Themes[value])
    end
    return copyTable(Themes.Dark)
end

function Snowy:CreateWindow(config)
    config = type(config) == "table" and config or {}

    local settings = copyTable(config)
    if settings.Title == nil then settings.Title = "SnowyCode UI" end
    if settings.Subtitle == nil then settings.Subtitle = "by snowy" end
    if settings.Theme == nil then settings.Theme = "Dark" end
    if settings.Transparency == nil then settings.Transparency = 0.08 end
    if settings.Blur == nil then settings.Blur = 12 end
    if settings.ToggleKey == nil then settings.ToggleKey = Enum.KeyCode.RightShift end
    if settings.Size == nil then settings.Size = UDim2.new(0, 668, 0, 478) end
    if settings.ShowUser == nil then settings.ShowUser = true end
    if settings.Open == nil then settings.Open = true end
    if settings.Shadow == nil then settings.Shadow = true end
    if settings.Footer == nil then settings.Footer = true end
    if settings.MinimizeButton == nil then settings.MinimizeButton = true end
    if settings.CloseButton == nil then settings.CloseButton = true end

    local selfWindow = setmetatable({
        _config = settings,
        _theme = resolveTheme(settings.Theme),
        _tabs = {},
        _elements = {},
        _themeHooks = {},
        _connections = {},
        _notifications = {},
        _transparency = math.clamp(tonumber(settings.Transparency) or 0.08, 0, 0.6),
        _toggleKey = settings.ToggleKey,
        _open = false,
        _minimized = false,
        _dragged = false,
        _destroyed = false,
        _selected = nil,
        _popupClose = nil,
        _compact = false,
        _position = Vector2.new(0, 0),
        _size = Vector2.new(668, 478),
        _id = tostring(math.floor(os.clock() * 1000)) .. "_" .. tostring(guiCounter),
    }, Window)

    if settings.Accent then
        selfWindow._theme.Accent = settings.Accent
    end
    if settings.Accent2 then
        selfWindow._theme.Accent2 = settings.Accent2
    end
    if settings.Blur <= 0 then
        selfWindow._blurSize = 0
    else
