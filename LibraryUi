        BackgroundTransparency = window:_alpha(0.18),
        BorderSizePixel = 0,
        Text = "None",
        TextColor3 = theme.SubText,
        TextSize = 11,
        Font = FONT_MED,
        TextTruncate = Enum.TextTruncate.AtEnd,
        AutoButtonColor = false,
        Parent = control,
    })
    addCorner(button, 8)
    local buttonStroke = addStroke(button, theme.Stroke, 0.86, 1)

    local initial = keyName(config.Value)
    local element = createElement(window, tab, section, row, {
        _value = initial,
        _nameLabel = title,
        _hover = false,
        _listening = false,
        _listenStarted = 0,
    })

    local function setKey(name, silent)
        if element._destroyed then
            return
        end
        element._value = name
        element._listening = false
        button.Text = name or "None"
        button.TextColor3 = name and window._theme.Text or window._theme.SubText
        tw(buttonStroke, 0.18, {Color = window._theme.Stroke, Transparency = 0.86})
        tw(button, 0.18, {BackgroundTransparency = window:_alpha(0.18)})
        if not silent then
            safeCall(config.Callback, name or "None", element)
        end
    end
    element._set = function(value, silent)
        if value == false or value == nil then
            setKey(nil, silent == true)
        else
            setKey(keyName(value), silent == true)
        end
    end

    bind(element, button.MouseButton1Click, function()
        if element._listening then
            setKey(nil, false)
            return
        end
        element._listening = true
        element._listenStarted = os.clock()
        button.Text = "Press a key..."
        button.TextColor3 = window._theme.Accent
        tw(buttonStroke, 0.18, {Color = window._theme.Accent, Transparency = 0.3})
    end)
    bind(element, UserInputService.InputBegan, function(input)
        if not element._listening then
            return
        end
        if os.clock() - element._listenStarted < 0.15 then
            return
        end
        local name = nameFromInput(input)
        if not name then
            return
        end
        if input.KeyCode == Enum.KeyCode.Escape
            or input.KeyCode == Enum.KeyCode.Backspace
            or input.KeyCode == Enum.KeyCode.Delete then
            name = nil
        end
        setKey(name, false)
    end)
    bind(element, button.MouseEnter, function()
        tw(buttonStroke, 0.15, {Transparency = 0.65})
    end)
    bind(element, button.MouseLeave, function()
        if not element._listening then
            tw(buttonStroke, 0.15, {Transparency = 0.86})
        end
    end)

    window:_hook(function(currentTheme)
        row.BackgroundColor3 = currentTheme.Surface
        title.TextColor3 = currentTheme.Text
        if desc then
            desc.TextColor3 = currentTheme.Muted
        end
        button.BackgroundColor3 = currentTheme.Input
        button.BackgroundTransparency = window:_alpha(0.18)
        buttonStroke.Color = currentTheme.Stroke
        button.TextColor3 = element._value and currentTheme.Text or currentTheme.SubText
    end)

    button.Text = initial or "None"
    return element
end

