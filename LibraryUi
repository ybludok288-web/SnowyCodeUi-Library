local function clampWindowPosition(position, size, viewport)
    local minX = math.min(0, 80 - size.X)
    local maxX = math.max(minX, viewport.X - 80)
    local minY = 0
    local maxY = math.max(0, viewport.Y - TOPBAR_H - 4)
    return Vector2.new(
        math.clamp(position.X, minX, maxX),
        math.clamp(position.Y, minY, maxY)
    )
end

local function parentScreenGui(gui)
    local candidates = {}

    local hasGethui = rawget(_G, "gethui")
    if type(hasGethui) == "function" then
        local ok, hidden = pcall(hasGethui)
        if ok and hidden then
            table.insert(candidates, hidden)
        end
    end

    local ok, core = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok and core then
        table.insert(candidates, core)
    end

    if LocalPlayer then
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            table.insert(candidates, playerGui)
        end
    end

    for _, parent in ipairs(candidates) do
        local success = pcall(function()
            gui.Parent = parent
        end)
        if success and gui.Parent then
            return parent
        end
    end

    if LocalPlayer then
        local okPlayerGui, playerGui = pcall(function()
            return LocalPlayer:WaitForChild("PlayerGui", 5)
        end)
        if okPlayerGui and playerGui then
            local success = pcall(function()
                gui.Parent = playerGui
            end)
            if success and gui.Parent then
                return playerGui
            end
        end
    end

    return nil
end

